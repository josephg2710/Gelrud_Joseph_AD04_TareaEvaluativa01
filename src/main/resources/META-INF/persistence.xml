<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd" version="3.0">
 <persistence-unit name="activaPU" transaction-type="RESOURCE_LOCAL">
  <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
  <class>com.joseph.ad04.domain.Monitor</class><class>com.joseph.ad04.domain.Actividad</class><class>com.joseph.ad04.domain.Cliente</class><class>com.joseph.ad04.domain.Reserva</class>
  <properties>
   <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
   <property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/dbactiva?serverTimezone=Europe/Madrid"/>
   <property name="jakarta.persistence.jdbc.user" value="root"/>
   <property name="jakarta.persistence.jdbc.password" value="CAMBIAR_CONTRASENA"/>
   <property name="hibernate.hbm2ddl.auto" value="validate"/>
   <property name="hibernate.show_sql" value="false"/>
   <property name="hibernate.format_sql" value="true"/>
  </properties>
 </persistence-unit>
</persistence>